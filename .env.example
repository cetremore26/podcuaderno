# Copy to .env to override docker compose defaults. Never commit .env.
POSTGRES_DB=podcuaderno
POSTGRES_USER=podcuaderno
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Must match FRONTEND_PORT: links in the emails open this URL.
FRONTEND_URL=http://localhost:3000
# Contact email for data protection requests, shown on the privacy policy page.
# Leave empty until it is published; the page then says it will be published soon.
PRIVACY_CONTACT_EMAIL=
# Optional; base64 of 32+ bytes, e.g. `openssl rand -base64 32`; empty = random key per start.
JWT_SECRET=
# Refresh cookie with the Secure flag; set to false only for Safari against plain-http localhost.
REFRESH_COOKIE_SECURE=true

# Real email delivery through Resend (ADR-0012). Leave commented to keep Mailpit.
# Without a verified domain, Resend only delivers to the email of the Resend account
# and the sender must be onboarding@resend.dev.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USERNAME=resend
# SMTP_PASSWORD=re_your_api_key
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# MAIL_FROM=Podcuaderno <onboarding@resend.dev>
